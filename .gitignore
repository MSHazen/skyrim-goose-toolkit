# User-specific settings (contains local paths)
.claude/settings.local.json

# Backups (generated at runtime)
.claude/backups/

# Node modules
node_modules/

# OS files
Thumbs.db
Desktop.ini
.DS_Store

# Nexus personal API key -- NEVER commit
tools/.nexus_api_key
.nexus_api_key
*.nexus_api_key

# Python virtualenv + test caches (dev only)
.venv/
__pycache__/
.pytest_cache/

# Machine-local paths recorded by setup.sh for the safety hooks. Never tracked:
# it names one user's directories, and shipping it would point another
# install's guard at a folder that does not exist there.
.claude/skyrim-paths.env

# Goose Toolkit runtime: machine-local paths, backups, generated state.
.local/

# YOUR knowledgebase, not ours. Never tracked and never shipped: the update path is
# "extract the new zip over your install", so any file the toolkit ships is replaced.
# A file that is both shipped by us and appended to by you loses your work on update.
KNOWLEDGEBASE.local.md

# External dependencies downloaded by user (not tracked)
tools/resaver-cli/ReSaver.jar
tools/resaver-cli/ReSaver.exe
tools/resaver-cli/ReSaver.bat
tools/resaver-cli/lib/
tools/resaver-cli/src/
tools/resaver-cli/target/
tools/resaver-cli/pom.xml
tools/resaver-cli/*.class
tools/resaver-cli/LICENSE.TXT
tools/resaver-cli/README.TXT
tools/resaver-cli/analysis-overlay/**/*.class
